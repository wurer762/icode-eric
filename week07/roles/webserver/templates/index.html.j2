<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>{{ inventory_hostname }}</title></head>
<body style="background: {{ page_color }}; color: white; font-family: sans-serif;
             text-align: center; padding-top: 15%;">
  <h1>Hello from {{ inventory_hostname }}</h1>
  <p>IP {{ ansible_default_ipv4.address | default('unknown') }} ·
     {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
  <p>Admins on this server:
{% for admin in admins if admin.state | default('present') == 'present' %}
    {{ admin.name }}{{ "," if not loop.last else "" }}
{% endfor %}
  </p>
  <p><small>Generated by Ansible - do not edit by hand</small></p>
</body>
</html>
